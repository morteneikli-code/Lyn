    <!-- Lynfakta -->
    <string name="fact_strikes_per_second_title">100 nedslag i sekundet</string>
    <string name="fact_strikes_per_second_body">Jorda treffes av lyn rundt 100 ganger hvert sekund — det blir omtrent 8 millioner nedslag per døgn.</string>
    <string name="fact_hotter_than_sun_title">Varmere enn sola</string>
    <string name="fact_hotter_than_sun_body">Ett lynnedslag kan varme opp lufta rundt seg til 30 000 °C — fem ganger så varmt som overflaten på sola.</string>
    <string name="fact_thin_but_long_title">Knivtynt, men kilometerlangt</string>
    <string name="fact_thin_but_long_body">Selve lynkanalen er bare 2–3 cm bred, men kan strekke seg 3–5 km eller mer gjennom lufta.</string>
    <string name="fact_thirty_thirty_title">30/30-regelen</string>
    <string name="fact_thirty_thirty_body">Hvis tordenen kommer mindre enn 30 sekunder etter lynet — søk ly. Vent 30 minutter etter siste tordenbrak før du går ut igjen.</string>
    <string name="fact_cars_safe_title">Biler er overraskende trygge</string>
    <string name="fact_cars_safe_body">En bil med hardt tak er et bra ly — ikke på grunn av gummidekkene, men fordi metallkarosseriet leder strømmen rundt passasjerene.</string>
    <string name="fact_same_place_title">Samme sted to ganger? Absolutt</string>
    <string name="fact_same_place_body">Empire State Building treffes av lyn 20–25 ganger i året. Høye bygg blir truffet om og om igjen.</string>
    <string name="fact_ozone_title">Lyn lager ozon</string>
    <string name="fact_ozone_body">Den enorme energien i et lynnedslag splitter nitrogen- og oksygenmolekyler, som så slår seg sammen til ozon (O₃).</string>
    <string name="fact_heat_lightning_title">«Varmelyn» er en myte</string>
    <string name="fact_heat_lightning_body">Varmelyn finnes ikke. Det du ser er vanlig lyn fra en storm som er for langt unna til at du hører tordenen.</string>
    <string name="fact_upward_title">Lyn går også oppover</string>
    <string name="fact_upward_body">Lyn slår ikke bare nedover. Oppoverlyn, der nedslaget går fra bakken opp til skya, er vanlig fra høye konstruksjoner.</string>
    <string name="fact_rubber_shoes_title">Gummisko hjelper ikke</string>
    <string name="fact_rubber_shoes_body">Gummisåler gir så å si null beskyttelse mot lyn. Med milliarder av volt involvert spiller noen millimeter gummi ingen rolle.</string>
